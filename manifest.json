{
  "manifest_version": 3,
  "name": "Fake Mic",
  "version": "0.1.0",
  "description": "用音频文件模拟麦克风，替换页面的 getUserMedia 音频输入，便于测试录音功能。",
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
      "js": ["src/main-world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
      "js": ["src/panel.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
